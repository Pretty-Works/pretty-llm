# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다. (.env 는 git에 올리지 말 것)
# 키 이름은 app/config.py 의 Settings 필드명을 대문자로 바꾼 것이다.

# ── 앱 ──
APP_NAME=pretty-llm agent server
DEBUG=false
LOG_LEVEL=INFO

# ── LLM ──
# langchain 이 환경변수에서 직접 읽는 경로가 있어 OPENAI_API_KEY 도 그대로 둔다.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MODEL_WORKER=gpt-4o-mini
LLM_MODEL_REASONING=gpt-4o
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# ── 백엔드(Spring) 연동 ──
# MOCK_BACKEND=true 면 HTTP 없이 demo_data 픽스처로 답한다.
BACKEND_BASE_URL=http://localhost:3001
INTERNAL_API_KEY=
# 들어오는 요청 검증용. BE 가 8개 경로 전부에 헤더를 보내기로 합의된 뒤에만 채운다
# (비워두면 검증을 건너뛰고 경고 로그만 남긴다). app/common/auth.py 참고.
INBOUND_API_KEY=
MOCK_BACKEND=true
BACKEND_CONNECT_TIMEOUT_S=3.0
BACKEND_READ_TIMEOUT_S=20.0
BACKEND_TIMEOUT=10
BACKEND_TOKEN=
TOOL_CALL_LIMIT=20

# ── HITL ──
CHECKPOINT_DB=data/checkpoints.sqlite

# ── Engine B 동작 파라미터 ──
WORKER_MAX_TOOL_CALLS=5
VALIDATOR_MAX_RETRIES=2
REPLAN_MAX_RETRIES=5
OVER_ALLOCATION_THRESHOLD=1.2
DUE_SOON_DAYS=7
LOW_CONFIDENCE_THRESHOLD=0.45

# ── 데모/테스트 재현성 ──
# "오늘"을 고정하고 싶을 때만 채운다. (YYYY-MM-DD)
AS_OF=

# ── Gmail MCP 연동 (app 쪽) ──
# gmail-mcp 서버(mcp_servers/gmail_mcp) 주소. 내부망 URL 권장, 외부에 직접 노출 X.
GMAIL_MCP_SERVER_URL=http://localhost:8100

# ── Gmail MCP 서버 자체 설정 (mcp_servers/gmail_mcp 프로세스가 읽음) ──
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google 콘솔에 등록한 리디렉션 URI와 바이트 단위로 같아야 한다.
GOOGLE_REDIRECT_URI=http://localhost:8100/oauth/gmail/callback
# 연결 성공/실패 후 사용자를 돌려보낼 프론트 URL
FRONTEND_SUCCESS_REDIRECT=http://localhost:3000/settings/integrations?gmail=connected
FRONTEND_FAILURE_REDIRECT=http://localhost:3000/settings/integrations?gmail=failed
# OAuth state 서명용 비밀키. 아무 랜덤 문자열이나 32자 이상으로.
GMAIL_MCP_STATE_SECRET=
# 저장되는 access/refresh token 암호화 키.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_MCP_TOKEN_ENCRYPTION_KEY=
GMAIL_MCP_CREDENTIAL_DB_PATH=data/gmail_credentials.sqlite

# ── Gmail MCP: run_id → user_id 조회 (Spring BE) ──
# gmail-mcp가 user_id를 직접 안 받고 run_id만 받아서 이 BE에 물어 user_id로 바꾼다.
# 위의 BACKEND_BASE_URL(Spring)을 그대로 재사용한다 — 새로 추가하는 값 아님.
# ★ 2026-08-12 BE 확정 — GET {BACKEND_BASE_URL}/api/internal/agent/runs/{runId}/user
#   (응답: {"userId": ...} 또는 {"user_id": ...}, 404면 run 없음/만료). {run_id}는
#   run_resolver.py 가 str.format 으로 채우는 자리라 스네이크케이스 그대로 둔다 —
#   BE 문서의 {runId} 표기와 이름만 다를 뿐 같은 자리다.
GMAIL_MCP_RUN_LOOKUP_PATH_TEMPLATE=/api/internal/agent/runs/{run_id}/user
# ⚠️ 이제 BE API가 나왔으니 true 로 두지 말 것 — 위 경로로 실제 조회가 되는지 먼저
# 확인한 뒤 false 로 바꿔라. run_id를 그대로 user_id로 취급하는 임시 우회로라, 켜둔
# 채로 운영하면 남의 run_id로 남의 Gmail 계정에 연결시킬 수 있는 구멍이 된다.
GMAIL_MCP_DEV_RUN_PASSTHROUGH=false
